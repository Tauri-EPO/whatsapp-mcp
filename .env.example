# This file serves both the local (uv / go run) setup and docker-compose.yml,
# which reads it as .env from the repo root. Compose-only keys are listed at
# the bottom.

# WhatsApp Bridge Configuration
# ==============================

# Port for the Go bridge REST API
WHATSAPP_BRIDGE_PORT=8080

# Listen address for the bridge REST API. Default 127.0.0.1 (loopback only).
# Set 0.0.0.0 (or ::) when the MCP server runs in another container/host,
# and list the Host names those clients will use below: without it a
# non-loopback bind still refuses every non-loopback Host header (403).
# Entries: "bridge" (any port), "bridge.example.com:8080" (exact), "*" (any).
# WHATSAPP_BRIDGE_BIND=127.0.0.1
# WHATSAPP_BRIDGE_ALLOWED_HOSTS=

# Webhook URL for incoming messages (optional)
# Set this to forward incoming WhatsApp messages to another service. Once set,
# the bridge authenticates every outbound webhook POST with the same bridge
# token it uses for inbound REST auth, sent as an
# "X-Bridge-Token: <WHATSAPP_BRIDGE_TOKEN>" header. A dedicated header is used
# instead of Authorization so it never collides with a receiver's own
# Authorization-based auth (e.g. HTTP Basic auth embedded in this URL as
# http://user:pass@host/...). The token is ONLY sent when this variable is
# explicitly set — never to the built-in localhost default below — since the
# same token also authorizes /api/* calls like sending messages, and nothing
# has vetted whatever process might be listening on an unconfigured default.
# Redirects are never followed, so a misconfigured or malicious endpoint can't
# redirect the token to a different host. The receiving service must expect
# that same token — see WHATSAPP_BRIDGE_TOKEN below.
# Off unless you have a receiver: enabling needs BOTH lines. The bridge's
# built-in default URL is http://localhost:8769/whatsapp/webhook, which in the
# compose stack points at nothing, so the container keeps webhooks disabled.
# WEBHOOK_ENABLED=true
# WEBHOOK_URL=http://your-receiver:8769/whatsapp/webhook

# Forward messages sent by self to the webhook (true/false)
# FORWARD_SELF=false

# Bearer token used to authenticate REST callers AND signed onto every outbound
# webhook POST (see WEBHOOK_URL above). The bridge generates one automatically at
# first start and writes it to .bridge-token in the active bridge store directory
# (mode 0600). The MCP server falls back to .bridge-token next to
# WHATSMEOW_DB_PATH. Override here to inject a token from the outside (e.g. from a
# secret store in a container) instead of mounting the file. If your webhook
# receiver enforces this token (e.g. the AutoHub hub's WHATSAPP_BRIDGE_TOKEN), it
# must be set to this exact value or inbound forwarding will be rejected.
# WHATSAPP_BRIDGE_TOKEN=

# Least-privilege mode for agents: comma-separated chats the MCP may read or
# act on. JIDs, bare phone numbers (= direct chat) or wildcards *@g.us (all
# groups) / *@s.whatsapp.net (all direct chats). Enforced by the MCP server
# (reads filtered, writes refused) and by the bridge (403 on outbound
# endpoints). Unset = everything allowed.
# WHATSAPP_ALLOWED_CHATS=5511999999999,120363000000000001@g.us

# Read-only mode — the recommended default for a personal assistant that reads
# and drafts while you send. The MCP server hides every mutating tool from
# tools/list (send_message, send_file, send_audio_message, send_reaction,
# send_typing, mark_messages_read, delete_message, edit_message,
# forward_message, manage_group_participants, update_group,
# get_group_invite_link, leave_group, purge_media, request_history) and refuses
# them if called
# anyway; the bridge answers 403 on the matching /api/* endpoints. Reads,
# download_media, transcribe_audio and annotate_media (local notes.db) stay
# available. Set it for BOTH processes. Accepts 1/true/yes/on and
# 0/false/no/off; anything else stops the process instead of defaulting to off.
# WHATSAPP_READ_ONLY=1

# Finer than read-only: pick tools by name (comma-separated, names as in
# docs/TOOLS.md). ALLOW is exhaustive — only the tools it lists are offered,
# reads included; DENY removes tools from whatever is left. Deny wins over allow
# and WHATSAPP_READ_ONLY wins over both, so these can only narrow the policy. A
# name that is not a tool stops the process at startup. Set BOTH for BOTH
# processes: the MCP server hides the tools, the bridge answers 403 on the
# endpoints they call (per endpoint, so /api/send stays open while any of
# send_message / send_file / send_audio_message is allowed; read endpoints stay
# open). "Read-only except reactions" is the allow-list below with
# WHATSAPP_READ_ONLY left unset — see docs/CONFIGURATION.md.
# WHATSAPP_ALLOW_TOOLS=list_chats,list_messages,search_contacts,send_reaction
# WHATSAPP_DENY_TOOLS=delete_message,leave_group,manage_group_participants

# Message content, contact/group names and media notes are written by third
# parties, so a message can carry a prompt injection. Every content-returning
# tool says so in its description already. Set this (MCP server only) to also
# wrap the data in <untrusted>...</untrusted> delimiters: message content,
# last_message, voice-note transcripts, note values, a group topic and a poll
# question. JIDs, message IDs, timestamps and cursors stay untouched so they can
# be fed back into the next call, and so do the name fields — those are
# sanitised in every mode instead (control, zero-width and bidi characters
# stripped, capped at 200 characters; a topic and a question are cleaned the
# same way, keeping their line breaks and capped at 4096).
# A hint to the model, not a control — the enforced mitigations are
# WHATSAPP_READ_ONLY and WHATSAPP_ALLOWED_CHATS. Off by default.
# WHATSAPP_WRAP_UNTRUSTED=1

# Colon-separated absolute paths that /api/send may read media files from.
# Default: ~/.local/share/whatsapp-mcp/outbox (created on first use). Files
# outside the listed roots are rejected with 403, defending against arbitrary-
# file-read abuse via media_path.
# WHATSAPP_MEDIA_ROOTS=/Users/yourname/.local/share/whatsapp-mcp/outbox:/Users/yourname/Pictures/wa-outbox

# Directory export_messages writes NDJSON archives into.
# Default: $WHATSAPP_STORE_DIR/exports (/app/store/exports in the containers,
# inside the whatsapp-store volume). The tool's out_path is always resolved
# under this directory; anything escaping it (.., an absolute path elsewhere, a
# symlink pointing out) is refused. Point it at a bind mount to get the files
# on the host directly.
# WHATSAPP_EXPORT_DIR=/srv/whatsapp-mcp/exports

# Inbound media cache. By default every image/audio/video is downloaded into
# store/<chat>/ as it arrives and kept forever. On an always-on server:
#   WHATSAPP_MEDIA_AUTODOWNLOAD=false  only download_media fetches files
#   WHATSAPP_MEDIA_RETENTION_DAYS=30   daily sweep deletes files older than N days
# Message rows keep their media metadata either way; download_media re-fetches
# (via media-retry when the CDN URL expired). /api/health shows store_bytes.
# WHATSAPP_MEDIA_AUTODOWNLOAD=true
# Inbound files above this many bytes are not cached on arrival (download_media
# still works). Default 256 MiB; 0 = no limit.
# WHATSAPP_MEDIA_MAX_BYTES=268435456
# WHATSAPP_MEDIA_RETENTION_DAYS=

# Group rosters. The bridge caches who belongs to each group so get_contact_chats
# can answer "which groups is this person in?" without a live call per group, and
# refreshes any roster older than this many hours in the background (one group per
# second, only while connected). 0 turns the background pass off; rosters are then
# only cached when list_group_members is called, when a join/leave/promote/demote
# event arrives, and when a group message comes from someone with no row yet.
# Refreshing is a read, so it keeps running under WHATSAPP_READ_ONLY.
# WHATSAPP_GROUP_ROSTER_SYNC_HOURS=6

# Label shown for this connection in WhatsApp under Settings > Linked Devices.
# whatsmeow's built-in default is the literal "whatsmeow", which looks opaque to
# end users. Set this to a recognisable name (e.g. your product or company) so
# the linked device is identifiable. Only takes effect at pair time: an existing
# session keeps the name from when its QR was scanned, so re-pair to change it.
# It is a cosmetic label only and does not change how the client behaves.
# WHATSAPP_DEVICE_NAME=


# MCP Server Configuration
# ========================

# Directory holding everything the bridge persists (session, messages.db,
# media, .bridge-token, .bridge.lock). Both processes read it; absolute paths
# are recommended for services. Bridge default: ./store (relative to its cwd).
# WHATSAPP_STORE_DIR=/srv/whatsapp-mcp/store

# Seconds the MCP server waits for each bridge REST call (default 30; media 120).
# WHATSAPP_BRIDGE_TIMEOUT_S=30

# Log verbosity. Bridge: DEBUG, INFO (default), WARN, ERROR — DEBUG also
# echoes every stored message, so keep INFO on a shared host. MCP server:
# Python logging level names (default INFO), always written to stderr.
# WHATSAPP_LOG_LEVEL=INFO
# WHATSAPP_MCP_LOG_LEVEL=INFO

# Log format: text (default) or json (one object per line, for Loki / Elastic
# / journald shippers).
# WHATSAPP_LOG_FORMAT=text
# WHATSAPP_MCP_LOG_FORMAT=text

# Prometheus text endpoints, on by default: GET /metrics on the bridge port
# (8080) and on the MCP port (8000). Counts and connection state only, never
# message content; unauthenticated. Set false to remove them.
# WHATSAPP_METRICS=true
# WHATSAPP_MCP_METRICS=true
# Behind Tailscale Funnel the MCP /metrics would be public: put a bearer token
# in front of it (Prometheus: bearer_token_file) or disable it.
# WHATSAPP_MCP_METRICS_TOKEN=

# URL your MCP clients use to reach this server. Only used to watch the TLS
# certificate the host publishes (tailscale serve / reverse proxy): bridge_status
# then reports endpoint_cert_expires_at, endpoint_cert_days_left and
# endpoint_cert_error. One handshake, no request, cached for an hour.
# WHATSAPP_PUBLIC_URL=https://myserver.tail1234.ts.net/mcp

# Container timezone for log timestamps and the daily media sweep (default UTC).
# TZ=America/Sao_Paulo

# Path to the SQLite messages database (overrides WHATSAPP_STORE_DIR)
# Default: $WHATSAPP_STORE_DIR/messages.db
WHATSAPP_DB_PATH=./whatsapp-bridge/store/messages.db

# Path to whatsmeow's SQLite database (used to resolve LIDs ↔ phone numbers)
# Default: $WHATSAPP_STORE_DIR/whatsapp.db
WHATSMEOW_DB_PATH=./whatsapp-bridge/store/whatsapp.db

# Go bridge REST API URL
WHATSAPP_API_URL=http://localhost:8080/api

# Transport used to serve MCP clients (Claude Desktop, Cursor, etc.).
#   stdio (default) — local launch over stdin/stdout, no network exposure
#   http            — streamable-http, the current spec transport for remote MCP
#   sse             — legacy Server-Sent Events transport (deprecated in the spec)
# WHATSAPP_MCP_TRANSPORT=stdio

# Host/port for the http and sse transports (ignored for stdio).
# Default 127.0.0.1 keeps the server reachable only from this machine; change to
# 0.0.0.0 to expose it on the network and put authentication in front of it.
# WHATSAPP_MCP_HOST=127.0.0.1
# WHATSAPP_MCP_PORT=8000

# Hostnames clients use to reach the http/sse server (comma-separated). The MCP
# SDK rejects any other Host header with 421 Misdirected Request (DNS-rebinding
# protection). Loopback is always allowed; a bare hostname matches any port.
# Required when reaching the server via Tailscale, Docker or a reverse proxy.
# "*" disables the check entirely.
# WHATSAPP_MCP_ALLOWED_HOSTS=myserver.tail1234.ts.net,whatsapp-mcp
# Extra Origin header values for browser-based clients (comma-separated).
# WHATSAPP_MCP_ALLOWED_ORIGINS=

# Requests per minute per client on the http/sse transports (429 + Retry-After
# beyond that). Default 120 when a bearer token is enforced, 0 (off) otherwise.
# WHATSAPP_MCP_RATE_LIMIT=120
# Maximum request body in bytes (default 4 MiB).
# WHATSAPP_MCP_MAX_BODY_BYTES=4194304

# Static bearer token for the http/sse transports. Every request must send
# "Authorization: Bearer <token>"; anything else is answered with 401.
# Unset: on a non-loopback bind the MCP server reuses the bridge token
# (WHATSAPP_BRIDGE_TOKEN or .bridge-token), so one secret covers both. Set your
# own (>= 16 chars, e.g. openssl rand -hex 32) to use a different one, or
# "off" to run without auth deliberately.
# WHATSAPP_MCP_TOKEN=
# Voice-note transcription (transcribe_audio tool), fully local via whisper.cpp.
# Either a running whisper-server inference endpoint (the docker compose
# `whisper` profile serves one at this address) ...
# WHISPER_URL=http://127.0.0.1:8178/inference
# ... or the whisper shared by every stack on this host (docker-compose.whisper.yml,
# reached through the docker-compose.shared-whisper.yml override, see COMPOSE_FILE below) ...
# WHISPER_URL=http://whisper:8178/inference
# ... or a local whisper-cli binary plus a ggml model file.
# WHISPER_BIN=/usr/local/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper/ggml-small.bin
# Default transcript language (ISO-639-1); "auto" lets whisper detect it.
# WHISPER_LANGUAGE=pt
# WHISPER_TIMEOUT_S=300
# Transcribe inbound voice notes in the background as they arrive, instead of
# only when an agent calls transcribe_audio. Off by default: whisper costs CPU
# on this machine and the worker will chew through the whole backlog. Needs a
# backend above, or it stays off with a warning. Failures are parked with a
# transcript_error note, never retried in a loop. See docs/CONFIGURATION.md.
# TRANSCRIBE_ON_INGEST=1
# Seconds between batches (minimum 5) and voice notes per batch (maximum 200).
# TRANSCRIBE_ON_INGEST_INTERVAL_S=300
# TRANSCRIBE_ON_INGEST_BATCH=10
# Let the worker download uncached audio from the bridge instead of skipping it
# (auto-download off, or the bytes already purged). Off by default: it spends
# bandwidth and the downloaded voice notes stay in the store, like any other
# download. The batch above bounds the attempts too.
# TRANSCRIBE_ON_INGEST_FETCH=1
# Seconds an ffmpeg conversion may take (voice-note encode, whisper WAV prep).
# FFMPEG_TIMEOUT_S=120

# Stdio parent-liveness watchdog poll interval (seconds).
# Soft stdin EOF alone does not exit; process exits when the original parent is
# gone (POSIX reparent) or on SIGTERM/SIGINT/SIGHUP.
# WHATSAPP_PARENT_WATCHDOG_S=30


# Docker Compose only (docker-compose.yml)
# ========================================
# See docs/DOCKER.md. Values above (WHATSAPP_BRIDGE_TOKEN, WEBHOOK_*,
# WHATSAPP_DEVICE_NAME, WHATSAPP_MCP_ALLOWED_HOSTS, WHATSAPP_MCP_PORT) are
# passed through to the containers as well.

# Several accounts on one host: one checkout and one compose project per
# account, each with its own COMPOSE_PROJECT_NAME (prefixes the volumes and
# container names, not ./outbox), WHATSAPP_MCP_PORT, WHATSAPP_MCP_TOKEN,
# WHATSAPP_DEVICE_NAME, WHATSAPP_PUBLIC_URL and policy variables
# (docs/DOCKER.md, "Several instances on one host").
# COMPOSE_PROJECT_NAME=whatsapp-mcp

# Host interface the MCP port is published on. Keep loopback and front it with
# `tailscale serve` or an authenticating reverse proxy.
# WHATSAPP_MCP_BIND=127.0.0.1

# Host directory mounted at /app/outbox in both containers; send_file may only
# read from there (WHATSAPP_MEDIA_ROOTS inside the container).
# WHATSAPP_OUTBOX=./outbox

# Which published image to run (docker compose pull): "latest" is the last
# release (default), "main" the edge build of the default branch, "vX.Y.Z",
# "X.Y" or "sha-<7 chars>" pin a version (rollback). Ignored when you build
# locally with --build. WHATSAPP_IMAGE_REGISTRY points at a mirror.
# WHATSAPP_IMAGE_TAG=latest
# WHATSAPP_IMAGE_REGISTRY=ghcr.io/tauri-epo

# whisper profile (docker compose --profile whisper up -d): model downloaded on
# first start into the whisper-models volume; threads for CPU inference.
# Set COMPOSE_PROFILES so *every* `up` keeps the profile on: whisper joins the
# bridge's network namespace, so an `up` without it recreates the bridge and
# leaves whisper attached to a namespace that no longer exists (TROUBLESHOOTING.md).
# COMPOSE_PROFILES=whisper
# Several stacks on one host: run one whisper for all of them instead of the
# profile (docker compose -f docker-compose.whisper.yml -p whisper up -d), layer
# the override on this stack and point WHISPER_URL at http://whisper:8178/inference.
# The model/thread/limit knobs below are read by the shared project too.
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-whisper.yml
# WHISPER_MODEL_NAME=small
# WHISPER_THREADS=4
# Resource cap for the whisper container (Docker memory/cpus syntax).
# WHISPER_MEM_LIMIT=3g
# WHISPER_CPUS=4
